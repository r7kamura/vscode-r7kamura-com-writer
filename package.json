{
  "name": "r7kamura-com-writer",
  "displayName": "r7kamura-com-writer",
  "description": "VSCode extension for r7kamura.com.",
  "publisher": "r7kamura",
  "repository": {
    "type": "git",
    "url": "https://github.com/r7kamura/vscode-r7kamura-com-writer.git"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.61.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:r7kamura-com-writer.create"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "r7kamura-com-writer.create",
        "title": "Create new diary for r7kamura.com"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/glob": "^7.1.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "glob": "^7.1.7",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3"
  }
}
